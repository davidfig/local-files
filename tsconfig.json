{
  "compilerOptions": {
    "target": "es6",
    "noImplicitAny": true,
    "removeComments": false,
    "sourceMap": true,
    "inlineSources": true,
    "declaration": true,
    "esModuleInterop": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "outDir": ".",
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true
  },
  "files": [
    "src/localFiles.ts",
    "src/localFilesServer.ts",
    "src/cli.ts"
  ],
  "exclude": [
    "node_modules/**/*",
    "dist"
  ]
}
